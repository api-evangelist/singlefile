{
  "opencollection": "1.0.0",
  "info": {
    "name": "SingleFile External API Documentation documents schemas API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.demo.singlefile.ai/o/token/",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "schemas",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "schemas_list_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.demo.singlefile.ai/external-api/v1/schemas/list"
          },
          "docs": "Handle GET request for schema list."
        },
        {
          "info": {
            "name": "schemas_read",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.demo.singlefile.ai/external-api/v1/schemas"
          },
          "docs": "Retrieve JSON schema for order payloads based on entity_type, filing_type, and jurisdiction."
        }
      ]
    }
  ],
  "bundled": true
}