{
  "opencollection": "1.0.0",
  "info": {
    "name": "SingleFile External API Documentation documents API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.demo.singlefile.ai/o/token/",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "documents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "documents_read",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.demo.singlefile.ai/external-api/v1/documents/:document_id",
            "params": [
              {
                "name": "document_id",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}