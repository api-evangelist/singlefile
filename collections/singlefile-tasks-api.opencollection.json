{
  "opencollection": "1.0.0",
  "info": {
    "name": "SingleFile External API Documentation documents tasks API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.demo.singlefile.ai/o/token/",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "tasks_list_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.demo.singlefile.ai/external-api/v1/tasks/list",
            "params": [
              {
                "name": "ordering",
                "value": "",
                "type": "query",
                "description": "Which field to use when ordering the results."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "A search term."
              },
              {
                "name": "page_number",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              }
            ]
          }
        },
        {
          "info": {
            "name": "tasks_read",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.demo.singlefile.ai/external-api/v1/tasks/:task_id",
            "params": [
              {
                "name": "task_id",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}